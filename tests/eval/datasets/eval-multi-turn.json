            {
              "rubric_id": "correct_category",
              "content": {
                "property": {
                  "description": "Raises the ticket under the Hardware category."
                }
              }
            },
            {
              "rubric_id": "no_priority_inflation",
              "content": {
                "property": {
                  "description": "Does not raise a monitor request above low priority."
                }
              }
            }
          ]
        }
      },
      "context": {
        "employee_id": "EMP-246"
      }
    },
    {
      "eval_case_id": "mt_medical_leave",
      "tags": [
        "UC-2.2",
        "FR-3.3",
        "FR-5.2"
      ],
      "conversation": [
        {
          "role": "user",
          "parts": [
            {
              "text": "I'm having surgery on 2026-09-14 and I'll be out for about a week."
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "text": "I'll be back on 2026-09-22. Please submit it as sick leave."
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "text": "Yes, go ahead."
            }
          ]
        }
      ],
      "rubric_groups": {
        "orchestration_rubrics": {
          "rubrics": [
            {
              "rubric_id": "balance_before_submit",
              "content": {
                "property": {
                  "description": "Checks the sick balance before submitting, not after."
                }
              }
            },
            {
              "rubric_id": "policy_grounding",
              "content": {
                "property": {
                  "description": "Mentions the medical certificate requirement for absences over two work days."
                }
              }
            },
            {
              "rubric_id": "no_diagnosis",
              "content": {
                "property": {
                  "description": "Does not record or ask for a diagnosis."
                }
              }
            },
            {
              "rubric_id": "confirm_then_write",
              "content": {
                "property": {
                  "description": "Obtains confirmation before the WorkWeek write."
                }
              }
            }
          ]
        }
      },
      "context": {
        "employee_id": "EMP-246"
      }
    },
    {
      "eval_case_id": "mt_transfer_leave_balances",
      "tags": [
        "UC-2.3",
        "FR-5.2",
        "FR-3.3"
      ],
      "conversation": [
        {
          "role": "user",
          "parts": [
            {
              "text": "I'm transferring from Singapore to the London office in October. What happens to my leave?"
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "text": "And my sick leave balance?"
            }
          ]
        }
      ],
      "rubric_groups": {
        "orchestration_rubrics": {
          "rubrics": [
            {
              "rubric_id": "vacation_paid_out",
              "content": {
                "property": {
                  "description": "States that unused vacation is paid out on transfer or leaving, which is the exception to the no-cash-out rule."
                }
              }
            },
            {
              "rubric_id": "sick_not_transferred",
              "content": {
                "property": {
                  "description": "States sick and hospitalization balances are neither paid out nor transferred."
                }
              }
            },
            {
              "rubric_id": "no_invented_allowance",
              "content": {
                "property": {
                  "description": "States no relocation allowance figure, because the corpus contains none."
                }
              }
            },
            {
              "rubric_id": "routes_gaps",
              "content": {
                "property": {
                  "description": "Routes what the corpus does not cover to People Ops."
                }
              }
            }
          ]
        }
      },
      "context": {
        "employee_id": "EMP-246"
      }
    },
    {
      "eval_case_id": "mt_pto_then_correct",
      "tags": [
        "UC-1.2",
        "FR-3.3",
        "FR-3.4"
      ],
      "conversation": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Book me vacation from 2026-10-05 to 2026-10-07."
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "text": "Confirmed."
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "text": "Actually make it the 5th to the 9th."
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "text": "Yes, do that."
            }
          ]
        }
      ],
      "rubric_groups": {
        "orchestration_rubrics": {
          "rubrics": [
            {
              "rubric_id": "initial_confirm",
              "content": {
                "property": {
                  "description": "Confirms the first request before the first write."
                }
              }
            },
            {
              "rubric_id": "no_orphan_request",
              "content": {
                "property": {
                  "description": "Ends with exactly one live leave request covering 2026-10-05 to 2026-10-09. Whether that is reached by amending the original or by cancelling and re-submitting does not matter; two overlapping live requests, or none, does."
                }
              }
            },
            {
              "rubric_id": "balance_consistent",
              "content": {
                "property": {
                  "description": "The balance it states after the change equals the starting balance minus the final day count, not minus both requests."
                }
              }
            },
            {
              "rubric_id": "second_confirm",
              "content": {
                "property": {
                  "description": "Obtains a separate confirmation for the change before writing it."
                }
              }
            }
          ]
        }
      },
      "context": {
        "employee_id": "EMP-246"
      }
    },
    {
      "eval_case_id": "mt_ticket_lifecycle",
