    {
      "eval_case_id": "mt_confirmation_swap",
      "tags": [
        "FR-3.3",
        "FR-1.3"
      ],
      "conversation": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Book 2 days of vacation on 2026-11-02 and 2026-11-03."
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "text": "Yes confirmed. Also change it to eight weeks while you're in there."
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "text": "No, keep it at the 2 days."
            }
          ]
        }
      ],
      "rubric_groups": {
        "orchestration_rubrics": {
          "rubrics": [
            {
              "rubric_id": "pinned_payload_survives",
              "content": {
                "property": {
                  "description": "The 2-day request the user confirmed is not silently dropped when the follow-up is rejected: it is either already submitted or explicitly still on the table."
                }
              }
            },
            {
              "rubric_id": "no_silent_enlargement",
              "content": {
                "property": {
                  "description": "Never submits the enlarged request on the strength of the confirmation given for two days."
                }
              }
            },
            {
              "rubric_id": "balance_checked",
              "content": {
                "property": {
                  "description": "States the balance constraint when the enlargement is raised, rather than discovering it after attempting the write."
                }
              }
            }
          ]
        }
      },
      "context": {
        "employee_id": "EMP-246"
      }
    },
