    {
      "eval_case_id": "uc21_equipment_eligible",
      "tags": [
        "UC-2.1",
        "FR-5.2",
        "FR-3.2",
        "FR-4.2",
        "NFR-2.3"
      ],
      "agent_data": {
        "agents": {
          "supervisor": {
            "agent_id": "supervisor",
            "agent_type": "SupervisorAgent",
            "instruction": "Orchestrate HR and IT self-service across the policy corpus, WorkWeek HCM and ServiceImmediately ITSM. Confirm before every mutation.",
            "tools": [
              {
                "function_declarations": [
                  {
                    "name": "vertex_search_policies",
                    "description": "Search the approved HR policy corpus."
                  },
                  {
                    "name": "get_employee_profile",
                    "description": "Work metadata: role, department, manager, work_location."
                  },
                  {
                    "name": "get_personal_info",
                    "description": "Home address and phone only."
                  },
                  {
                    "name": "get_employee_balances",
                    "description": "Vacation and Sick balances."
                  },
                  {
                    "name": "request_time_off",
                    "description": "Submit a leave request."
                  },
                  {
                    "name": "update_personal_info",
                    "description": "Update home address and phone. Both fields required."
                  },
                  {
                    "name": "list_tickets",
                    "description": "List the caller's tickets."
                  },
                  {
                    "name": "get_ticket_details",
                    "description": "Ticket detail and comment timeline."
                  },
                  {
                    "name": "create_ticket",
                    "description": "Create an incident."
                  },
                  {
                    "name": "add_ticket_comment",
                    "description": "Comment on a ticket."
                  },
                  {
                    "name": "update_ticket_status",
                    "description": "Transition ticket state."
                  }
                ]
              }
            ]
          }
        },
        "turns": [
          {
            "turn_index": 1,
            "user": "I read the remote work policy and I think I can get a monitor. Can you check and order one?",
            "expected_behaviour": "Runs vertex_search_policies and get_employee_profile concurrently. Confirms eligibility from work_location, not from the user's claim. Reads get_personal_info only after eligibility passes. Presents a confirmation naming the shipping address."
          },
          {
            "turn_index": 2,
            "user": "yes",
            "expected_behaviour": "Calls create_ticket with category Hardware, priority 4 - Low, requested_by set to the session employee_id. Reports the ticket ID."
          }
        ]
      },
      "rubric_groups": {
        "orchestration_rubrics": {
          "rubrics": [
            {
              "rubric_id": "eligibility_from_record",
              "content": {
                "property": {
                  "description": "Eligibility is decided from work_location in the WorkWeek profile, never from the user's statement."
                }
              }
            },
            {
              "rubric_id": "parallel_reads",
              "content": {
                "property": {
                  "description": "The policy lookup and the profile read are issued concurrently, not serially."
                }
              }
            },
            {
              "rubric_id": "address_after_eligibility",
              "content": {
                "property": {
                  "description": "get_personal_info is called only after eligibility passes."
                }
              }
            },
            {
              "rubric_id": "confirmation_before_create",
              "content": {
                "property": {
                  "description": "No ticket is created before an affirmative confirmation."
                }
              }
            },
            {
              "rubric_id": "citation_present",
              "content": {
                "property": {
                  "description": "The eligibility statement cites the remote work policy."
                }
              }
            }
          ]
        }
      }
    },
