            {
              "rubric_id": "resolve_with_notes",
              "content": {
                "property": {
                  "description": "Proposes Resolved with notes as the correct route."
                }
              }
            },
            {
              "rubric_id": "confirm_each",
              "content": {
                "property": {
                  "description": "Confirms each state change."
                }
              }
            }
          ]
        }
      },
      "context": {
        "employee_id": "EMP-246"
      }
    },
    {
