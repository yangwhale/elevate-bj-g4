    {
      "eval_case_id": "mt_equipment_request",
      "tags": [
        "UC-2.1",
        "FR-4.2",
        "FR-3.3"
      ],
      "conversation": [
        {
          "role": "user",
          "parts": [
            {
              "text": "I'm working from home permanently now and I need a second monitor."
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "text": "Yes please, go ahead."
            }
          ]
        }
      ],
      "rubric_groups": {
        "orchestration_rubrics": {
          "rubrics": [
            {
              "rubric_id": "checks_location",
              "content": {
